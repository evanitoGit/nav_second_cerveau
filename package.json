{
  "name": "nav-second-cerveau",
  "version": "0.1.0",
  "description": "Navigateur desktop avec mémoire visuelle et sémantique locale",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "install-electron",
    "setup:linux-sandbox": "bash scripts/setup-linux-sandbox.sh",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "@huggingface/transformers": "^4.3.2",
    "electron-updater": "^6.8.11",
    "sharp": "^0.35.5",
    "sqlite-vec": "^0.1.9"
  },
  "productName": "Second Cerveau",
  "author": {
    "name": "evanitoGit"
  },
  "homepage": "https://github.com/evanitoGit/nav_second_cerveau",
  "repository": {
    "type": "git",
    "url": "https://github.com/evanitoGit/nav_second_cerveau.git"
  },
  "license": "UNLICENSED"
}
